# Copy to `.env`, fill in, then load before running:
#   set -a; source scripts/.env; set +a
# NEVER commit the real .env (see .gitignore).

# Your own Apify account token (Apify Console → Settings → Integrations).
# NOTE: this tool meters per keyword — a real run costs a few dollars on YOUR
# account, more than Apify's free monthly credit. The forecast prints the
# estimate before it spends.
APIFY_TOKEN=

# No LLM API key needed. The S1 report is written by a cheap-model subagent via
# the `claude` CLI — no extra cost beyond your normal Claude usage.
