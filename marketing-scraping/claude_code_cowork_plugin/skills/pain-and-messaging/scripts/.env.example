# Copy to `.env`, fill in, then load before running:
#   set -a; source scripts/.env; set +a
# NEVER commit the real .env (see .gitignore).

# Your own Apify account token (Apify Console → Settings → Integrations).
APIFY_TOKEN=

# No LLM API key needed. The E1/E2 report is written by your own `claude` CLI
# (a capable model such as sonnet, since clustering the findings and writing the
# report is a judgment task, not the cheapest model). No extra cost beyond your
# normal Claude usage. Override the model with `report_model` in your config.
